{
  "private": true,
  "scripts": {
    "format": "prettier -w --cache '**/*.ts'",
    "lint": "eslint --cache '**/*.ts'",
    "typecheck": "tsc",
    "build": "esbuild --bundle --platform=node src/main.ts --outdir=dist --minify"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.14.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/github": "9.1.1",
    "@actions/http-client": "4.0.1",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/format": "21.2.3",
    "@commitlint/lint": "21.2.3",
    "defu": "^6.1.7",
    "micromatch": "^4.0.8",
    "p-limit": "^7.3.3",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  }
}
